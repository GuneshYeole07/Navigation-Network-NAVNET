# Same database as the NavNet API (read-only use).
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/navnet
# Shared secret: set the same value as ANALYTICS_KEY in server/.env
ANALYTICS_KEY=change-me
# Train the ETA model on startup if none is saved yet
AUTO_TRAIN=true

# Live safety monitor (possible crash / weak GPS / unusual movement). Turn it on here AND
# in server/.env (SAFETY_MONITOR=1); alerts are sent back to the API at API_URL.
# SAFETY_MONITOR=1
# API_URL=http://localhost:5000
