# Leave empty in development — Vite proxies /api, /uploads and /socket.io to localhost:5000.
# In production, set to your API origin if the API is hosted separately, e.g.
#   VITE_API_URL=https://navnet-api.onrender.com
VITE_API_URL=
# Optional: separate Socket.IO origin (defaults to VITE_API_URL)
VITE_SOCKET_URL=
# Show the "fill in the demo account" link on the login screens
VITE_SHOW_DEMO=true
# Maps (all optional). Default: OpenFreeMap vector map, OSM raster fallback.
# Use any other MapLibre style instead:
# VITE_MAP_STYLE_URL=https://tiles.openfreemap.org/styles/bright
# VITE_MAP_STYLE_URL_DARK=https://tiles.openfreemap.org/styles/dark
# Raster fallback tiles:
# VITE_TILE_URL=https://tile.openstreetmap.org/{z}/{x}/{y}.png
