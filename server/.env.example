# ── Required ──────────────────────────────────────────────
# PostgreSQL connection string
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/navnet
# Long random string used to sign JWTs. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=change-me-to-a-long-random-string

# ── Server ────────────────────────────────────────────────
PORT=5000
NODE_ENV=development
JWT_EXPIRES_IN=7d
# Comma-separated list of allowed browser origins (CORS + Socket.IO)
# Extra origins allowed to call the API (comma-separated, wildcards ok).
# Not needed when the app is served by this server or through the Vite proxy (same origin).
CLIENT_ORIGIN=http://localhost:5173
# Invite code required to register a new Admin account (leave empty to disable admin signup)
ADMIN_SIGNUP_CODE=NAVNET-ADMIN-2026
UPLOAD_DIR=uploads

# ── Open-source maps & routing (no Google) ────────────────
# Optional free key from https://openrouteservice.org/dev/#/signup — better routes.
ORS_API_KEY=
# OSRM fallback (public demo server, or your own instance)
OSRM_URL=https://router.project-osrm.org
NOMINATIM_URL=https://nominatim.openstreetmap.org
# Fallback place search (also OpenStreetMap data, no key)
PHOTON_URL=https://photon.komoot.io
# Fuel / hospital / mechanic along the route (OpenStreetMap Overpass API, no key)
OVERPASS_URL=https://overpass-api.de/api/interpreter
# Nominatim's usage policy requires an identifying User-Agent (put your contact)
GEO_USER_AGENT=NavNet/1.0 (your-email@example.com)

# ── Smart monitoring thresholds ───────────────────────────
OFF_ROUTE_METERS=300
STATIONARY_MINUTES=5
OFFLINE_SECONDS=60
LOW_BATTERY_PERCENT=20
WRONG_DIRECTION_METERS=250
ARRIVAL_METERS=150
CHECKPOINT_METERS=200
ALERT_COOLDOWN_SECONDS=300
PING_PERSIST_SECONDS=10
SWEEP_INTERVAL_SECONDS=15

# ── Tests ─────────────────────────────────────────────────
# Defaults to DATABASE_URL with "_test" appended to the database name
# TEST_DATABASE_URL=postgresql://postgres:postgres@localhost:5432/navnet_test

# Your own map tiles (optional): path or https URL of a .pmtiles file. See docs/DEPLOYMENT.md.
# PMTILES_PATH=./maps/india.pmtiles

# Python analytics service (optional): ride insights + machine-learned ETA. See analytics/README.md.
# ANALYTICS_URL=http://localhost:8000
# ANALYTICS_KEY=change-me
# Stream positions to the Python safety monitor (needs ANALYTICS_KEY; set it in analytics/.env too)
# SAFETY_MONITOR=1
# Automation webhooks (n8n / Zapier / Make): SOS, possible crash, trip ended… See integrations/n8n.
# N8N_WEBHOOK_URL=https://your-n8n.example.com/webhook/navnet-events
# N8N_WEBHOOK_SECRET=pick-a-long-random-string
# Local load tests only (python -m loadtest.run): no rate limits. Ignored in production.
# RATE_LIMIT_DISABLED=1
